# Pick one provider. With no key the service runs on the labelled stand-in generator.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Optional model override, e.g. claude-haiku-4-5, gpt-4o-mini, gemini-2.0-flash
LLM_MODEL=
# Set by docker compose. Unset = in-memory vector store.
QDRANT_URL=
# 1 = force stand-in embedder/reranker (CI). 1 in AGENTOPS_REQUIRE_MODELS = fail if MiniLM cannot load.
AGENTOPS_STANDIN=
AGENTOPS_REQUIRE_MODELS=
